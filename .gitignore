# ── 密钥：绝对不能进 git ──────────────────────────────────────
# .env 里放 DEEPSEEK_API_KEY。一旦提交，key 就永久留在历史里了，
# 删除文件也没用 —— 只能去后台作废重发。
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.sqlite3
/media/

# ── Node / 前端 ───────────────────────────────────────────────
node_modules/
dist/

# ── 打包产物：由 npm run build 生成，不进 git ──────────────────
backend/static/frontend/

# ── 编辑器 / 系统 ─────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
